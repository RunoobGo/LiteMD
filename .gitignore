# ============================================================================
# LiteMD .gitignore
# 版本：v1.1 ｜ 2026-08-13
# 说明：按「系统 → Go → Wails 构建 → 前端 → IDE/编辑器 → 日志临时」分层
# ============================================================================

# ----------------------------------------------------------------------------
# 1. 操作系统垃圾文件
# ----------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
# macOS 自定义图标资源文件
Icon\r
Icon\r?

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
# Windows 快捷方式
*.lnk

# Linux
*~

# ----------------------------------------------------------------------------
# 2. Go 语言
# ----------------------------------------------------------------------------
# 编译后的二进制（平台相关名也兜底）
*.exe
*.exe~
*.dll
*.so
*.dylib
*.out

# Go 测试二进制（go test -c 产物）
*.test

# 测试覆盖率
*.cover
*.cover.out
coverage.out
coverage.html
coverage/

# Vendor 目录（项目使用 Go modules，无需 vendor）
# vendor/

# Go workspace
go.work
go.work.sum

# ----------------------------------------------------------------------------
# 3. Wails 构建产物
# ----------------------------------------------------------------------------
# Wails 输出目录（二进制 + App Bundle）
build/bin/
build/*.log

# build-windows.sh 由 build_windows/ rsync 生成的同步目录（构建产物，不入库）
build/windows/

# UPX/打包中间产物
build/*.tmp

# ----------------------------------------------------------------------------
# 4. 前端 / Vite / Node
# ----------------------------------------------------------------------------
# Node 依赖
frontend/node_modules/
frontend/.pnpm-store/

# Vite 构建产物（由 npm run build 生成，Wails 构建时会自动跑，不入库）
frontend/dist/

# Wails 生成的 md5 校验（用于检测 package.json 变更）
frontend/package.json.md5

# Vite 缓存（v3 默认 node_modules/.vite，也显式列一下）
frontend/.vite/
frontend/*.tsbuildinfo

# Lint 缓存
frontend/.eslintcache

# 依赖锁文件备份
*.npm
*.yarn

# ----------------------------------------------------------------------------
# 5. 包管理器锁（可选：团队内部保持一致时可提交）
# ----------------------------------------------------------------------------
# 默认保留 package-lock.json / go.sum；如需纯离线构建可加下一行
# frontend/package-lock.json

# ----------------------------------------------------------------------------
# 6. IDE / 编辑器
# ----------------------------------------------------------------------------
# VSCode
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
*.code-workspace
.history/

# JetBrains GoLand / WebStorm / Idea
.idea/
*.iml
*.ipr
*.iws

# Vim / Neovim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock

# Sublime Text
*.sublime-workspace
*.sublime-project

# ----------------------------------------------------------------------------
# 7. 日志与临时文件
# ----------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

*.tmp
*.bak
*.old
*.cache
*.pid
*.seed

# ----------------------------------------------------------------------------
# 8. 环境变量 / 本地密钥
# ----------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
*.keystore
*.cert

# ----------------------------------------------------------------------------
# 9. E2E 屏幕截图外的临时产物（截图基准保留入库）
# ----------------------------------------------------------------------------
e2e/*.tmp.png
e2e/*.diff.png
e2e/*.log
