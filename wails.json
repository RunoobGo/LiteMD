{
  "$schema": "https://wails.io/schemas/config.v2.json",
  "name": "LiteMD",
  "outputfilename": "LiteMD",
  "frontend:install": "npm ci",
  "frontend:build": "npm run build",
  "frontend:dev:watcher": "npm run dev",
  "frontend:dev:serverUrl": "auto",
  "info": {
    "companyName": "LiteMD",
    "productName": "LiteMD",
    "productVersion": "0.2.12",
    "copyright": "Copyright © 2026 LiteMD",
    "comments": "A lightweight Markdown editor with Obsidian-compatible syntax",
    "fileAssociations": [
      { "ext": "md", "name": "Markdown Document", "description": "Markdown 文档", "role": "Editor", "iconName": "appicon" },
      { "ext": "markdown", "name": "Markdown Document", "description": "Markdown 文档", "role": "Editor", "iconName": "appicon" },
      { "ext": "mdown", "name": "Markdown Document", "description": "Markdown 文档", "role": "Editor", "iconName": "appicon" },
      { "ext": "mkd", "name": "Markdown Document", "description": "Markdown 文档", "role": "Editor", "iconName": "appicon" },
      { "ext": "mkdn", "name": "Markdown Document", "description": "Markdown 文档", "role": "Editor", "iconName": "appicon" }
    ]
  },
  "author": {
    "name": "",
    "email": ""
  }
}
